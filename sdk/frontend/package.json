{
  "name": "@lds/plugin-sdk",
  "version": "1.15.0",
  "description": "Public frontend contract and independent package builder for LDS plugins",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": "./runtime.js",
    "./help": "./help.js",
    "./setup": "./setup.js",
    "./camera-data": "./camera-data.js",
    "./theme": "./theme.js",
    "./build": "./build.mjs",
    "./ui": "./ui.js",
    "./data": "./data.js",
    "./training": "./training.js",
    "./links": "./links.js",
    "./bank": "./bank.js",
    "./search": "./search.js",
    "./lineage": "./lineage.js",
    "./inference": "./inference.js",
    "./files": "./files.js",
    "./canvas": "./canvas.js",
    "./lora": "./lora.js",
    "./h3": "./h3.js"
  },
  "bin": {
    "lds-plugin-build": "./build.mjs"
  },
  "files": [
    "*.js",
    "*.mjs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "autoprefixer": "10.4.20",
    "postcss": "8.5.23",
    "postcss-selector-parser": "6.1.5",
    "tailwindcss": "3.4.10",
    "vite": "6.4.5"
  }
}
