# API keys — copy this file to .env and fill in. NEVER commit .env.
GEMINI_API_KEY=
OPENAI_API_KEY=

# General Hugging Face token — gated base downloads and optional publishing.
HF_TOKEN=

# Full-model Krea 2 cloud training only. Prefer a SEPARATE fine-grained token with
# exact read scope for krea/Krea-2-Raw and read+write on one dedicated user/org
# namespace that contains only LDS private delivery repositories. Hugging Face
# cannot scope creation to a per-run repository before that repository exists.
# A classic/global token with role=write is accepted with a broad-access warning;
# read-only tokens are rejected. Avoid reusing a broad/general HF token here.
HF_CLOUD_TOKEN=

# Pexels API key — required for Pexels scans through the official API.
# Create one for free at https://www.pexels.com/api/key/ (200 requests/hour, 20,000/month).
# IMPORTANT: An API key alone does not authorize dataset or machine-learning use.
# Configure/use this integration only if Pexels has explicitly authorized this use case.
# Official terms: https://help.pexels.com/hc/en-us/articles/900005880463-What-are-the-Terms-and-Conditions
PEXELS_API_KEY=

# vast.ai API key — enables cloud GPU training (rent a GPU per run, auto-terminated).
# Get one at https://cloud.vast.ai/?ref_id=683073 -> Keys (referral link, disclosed in the README; the untagged https://cloud.vast.ai/ works the same). Typical training run costs ~$1-2.
VAST_API_KEY=

# ── Docker, GPU flavour (docker-compose.gpu.yml) ─────────────────────────────
# Only read by `docker compose`; the app itself ignores them. Safe to leave as is.
# Saving an API key in Settings rewrites this file but carries these lines through.

# Where the two ComfyUI trees and the studio's data live on the host.
# LDS_COMFY_BASEDIR is the PARENT containing models/, input/, output/ and
# custom_nodes/ — never models/ itself. Reuse that parent and nothing downloads twice.
#LDS_COMFY_RUN=./run
#LDS_COMFY_BASEDIR=./basedir
#LDS_DATA=./data-docker-gpu
# Optional persistent data folder for the Docker-managed Ollama sidecar.
#LDS_OLLAMA_DATA=./ollama-data

# Optional images for the 🗃️ Image bank to triage in place — a photo dump, a
# Telegram export, an existing library. Inside the container this folder is
# /images, and /images is what you type in "New bank": the host path below does
# not exist in there. Read-only in practice (only 🗑 Delete rejected writes);
# append `:ro` to the mount in docker-compose.gpu.yml to enforce that.
#LDS_BANK_SOURCES=./bank-images

# Must own the three folders above (`id -u` / `id -g`). Unraid: usually 99 / 100.
#LDS_UID=1000
#LDS_GID=1000

# Host ports for the studio and for ComfyUI's own web UI.
#LDS_HOST_PORT=5050
#LDS_COMFY_HOST_PORT=8188

# Which host interface those ports are published on. The default binds to
# loopback only, so nothing on your network can reach the studio or ComfyUI —
# neither of them asks for a password, so exposing them exposes your datasets,
# your models and your local file browser to every device on the LAN.
# Set 0.0.0.0 only if you deliberately want other machines to connect, and only
# on a network you trust.
#LDS_BIND_ADDRESS=127.0.0.1

# Last resort if the LDS_DATA mount (/data in the container) cannot be made
# writable from the host. This recursively changes ownership of /data ONLY;
# it never chowns LDS_COMFY_RUN, LDS_COMFY_BASEDIR or LDS_BANK_SOURCES.
#LDS_FORCE_CHOWN=true

# The resolver the container uses. Defaults to 1.1.1.1 because an inherited host
# resolver is often unreachable from inside a Compose network, and this image
# fetches from astral.sh on every start. Set your LAN's own (a router, a Pi-hole)
# if you reach anything by internal hostname. One address, not a list.
#LDS_DNS=1.1.1.1

# How much of the machine the container may use. Unlimited when unset; a cap that
# is too tight kills the first boot's torch install rather than slowing it.
# LDS_MEMSWAP_LIMIT is memory + swap COMBINED and must be >= LDS_MEM_LIMIT:
# unset means "twice LDS_MEM_LIMIT", equal to it means no swap, -1 unlimited swap.
# Swap capping needs swap accounting enabled in the host kernel; without it Docker
# warns and ignores the value. Suffixes: b, k, m, g.
#LDS_MEM_LIMIT=24g
#LDS_MEMSWAP_LIMIT=24g
#LDS_CPUS=8
