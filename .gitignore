# secrets & local config — NEVER commit
.env
.docker-launch-settings
.docker-launch-settings.tmp
.docker-compose.external-comfy.override.yml
.docker-compose.external-comfy.override.yml.tmp
# Per-machine dev overrides, e.g. frontend/.env.local pointing `npm run dev` at a
# throwaway backend instead of the real one (LDS_DEV_API_TARGET — see
# frontend/README.md). `.env` above does NOT cover these: it matches that exact
# name only.
.env.local
.env.*.local
config.json

# runtime data
data/

# docker bind mounts (docker-compose.yml / docker-compose.gpu.yml). ComfyUI's
# checkout, venv and model tree land here — tens of GB after one boot.
run/
basedir/
data-docker/
data-docker-gpu/
ollama-data/
bank-images/

*.db
*.db-shm
*.db-wal
*.log

# python
__pycache__/
*.pyc
.venv/
venv/
# Pinokio builds the app's venv here (install.js), next to the sources it runs.
/env/
.pytest_cache/
.pytest-basetemp-*/
**/.pytest-basetemp-*/

# node — every variant, not just the exact name: a stray copy or junction
# (node_modules_x, node_modules.bak, node_modules-old, ...) of this vendored
# tree must never become publishable, and it trips the privacy guard on
# third-party package-maintainer content it has no business scanning.
frontend/node_modules*/

# packaging build artifacts — release ZIP and optional local legacy bundle
packaging/build/
packaging/dist/
packaging/*.spec

# Generated release body (frontend/scripts/releaseNotes.mjs --out) — a build
# artifact of release.yml, and scratch when you run the generator by hand.
/release-notes.md

# OS
.DS_Store
Thumbs.db

# controller scratch / local dev tooling — NEVER commit
.superpowers/
.claude/*
!.claude/rules/
.playwright-mcp/

# internal planning artifacts (local machine paths) — keep local, never publish
docs/superpowers/

# Local privacy guard-rail: the identifiers test_no_personal_data.py must never
# find in tracked files. Kept OUT of the repo — writing them down here would
# publish exactly what they forbid.
.privacy-names

# Local-only extension drop-in dir (optional packages loaded at boot by
# backend/app/extension_loader.py). Never tracked, never shipped: also
# excluded by packaging/build_release_zip.ps1 (/XD) and refused by
# scripts/check_release_artifacts.py if it ever reaches an archive.
/backend/extensions/

# Written at the repo root by an external homelab dashboard (the port it
# found the server on). Not ours, machine-local, never shipped.
/.lds-dashboard-port
